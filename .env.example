# Copy this file to .env and add any keys you have. Every key is optional:
# with none, PayMates runs on its built-in rules engine and the demo still works.
# With several, each agent is routed to the provider that suits its job.

# Free tiers available (good for the finale):
GROQ_API_KEY=
GEMINI_API_KEY=

# Paid:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local models via Ollama (run `ollama pull llama3.1` first)
OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434/v1

# auto = use models when keys exist, else rules · offline = rules only (safest for a flaky venue Wi-Fi)
PAYMATES_MODE=auto

# Pin a specific model per agent (provider:model). Check model names on your provider's dashboard.
# PAYMATES_TRIAGE_MODEL=groq:llama-3.1-8b-instant
# PAYMATES_ACTION_MODEL=anthropic:claude-sonnet-5-5
# PAYMATES_RESPONDER_MODEL=gemini:gemini-flash-latest
# PAYMATES_ESCALATION_MODEL=openai:gpt-4.1-mini

# Pause between agent steps so the audience can follow the live trace (ms). 0 = full speed.
PAYMATES_PACING_MS=450
PAYMATES_LLM_TIMEOUT=15
